	<parameter name="p_test_id" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
*
FROM
        gc_data_sheet gc , req_tests rt , sample_test st  , reg_company c
    WHERE rt.id = gc.test_id
    and st.test_id =rt.test_id
    and c.company_id = gc.company_id
    and  gc.test_id =   $P{p_test_id}]]>
	</queryString>
